CLASS z_bifurcaciones_g17013 DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun .
  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.



CLASS z_bifurcaciones_g17013 IMPLEMENTATION.


  METHOD if_oo_adt_classrun~main.

*************  IF  *********************************************************

    DATA gv_numero TYPE i VALUE 10.

    IF gv_numero EQ 7.
      out->write( 'Número = 7' ).
    ELSE.
      out->write( 'Número distinto de 7' ).
    ENDIF.

****************  CASE  ******************************************************

    DATA gv_empresa TYPE string.

    gv_empresa = 'SAP'.

    CASE gv_empresa.
      WHEN 'LOGALI'.
        out->write( 'Academia' ).
      WHEN 'SAP'.
        out->write( 'Software empresarial' ).
      WHEN OTHERS.
        out->write( 'Desconocido' ).

    ENDCASE.

****************  DO  ******************************************************

    DATA gv_contador TYPE i.

    DO 10 TIMES.
      gv_contador += 1.
      out->write( |Contador = { gv_contador }| ).
      IF gv_contador EQ 7.
        EXIT.
      ENDIF.
    ENDDO.

****************  WHILE  ******************************************************
    DATA gv_contador2 TYPE i.

    WHILE  gv_contador2 LE 20.
      gv_contador2 += 1.

      IF gv_contador2 LE 10.
        out->write( |Contador2 = { gv_contador2 }| ).
      ENDIF.
    ENDWHILE.

**************  COND  ********************************************************

    DATA(gv_time) = COND #(
        WHEN sy-timlo < '120000' THEN |{ sy-timlo TIME = ISO } AM |
        WHEN sy-timlo > '120000' THEN |{ CONV t( sy-timlo - 11 * 3600 ) TIME = ISO } PM |
        WHEN sy-timlo = '120000' THEN | High Noon |
        ELSE |Horario no identificado|
    ).

    out->write( |La hora actual es: { gv_time }| ).

**************  SWITCH  ********************************************************

    gv_empresa = 'MOVISTAR'.

    DATA(gv_text) = SWITCH #( gv_empresa
    WHEN 'LOGALI' THEN |Academia SAP|
    WHEN 'SAP' THEN |Software empresarial|
    WHEN 'MOVISTAR' THEN |Telefonía|
    ELSE |Desconocido|
    ).

    out->write( gv_text ).





  ENDMETHOD.
ENDCLASS.