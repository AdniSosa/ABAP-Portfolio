  method write_calls_can_be_chained.
    data(cut) = new cl_oo_adt_classrun_output( ).

    data string_to_write type string.
    data name type string.
    data if_demo_output_mock type ref to if_demo_output.
    if_demo_output_mock ?= cl_abap_testdouble=>create( `if_demo_output` ).
    cl_abap_testdouble=>configure_call( if_demo_output_mock )->returning( if_demo_output_mock )->and_expect( )->is_called_times( 3 ).
    if_demo_output_mock->write( data = string_to_write
                                name = name ).
    cut->lo_demo_output = if_demo_output_mock.

    cut->if_oo_adt_classrun_out~write( data = string_to_write name = name )->write( data = string_to_write name = name )->write( data = string_to_write name = name ).

    cl_abap_testdouble=>verify_expectations( if_demo_output_mock ).
  endmethod.

