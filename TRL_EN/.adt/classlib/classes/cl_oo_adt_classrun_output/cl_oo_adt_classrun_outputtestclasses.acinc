    cl_abap_testdouble=>configure_call( if_demo_output_mock )->returning( string_to_return )->and_expect( )->is_called_once( ).
    if_demo_output_mock->get( data = string_to_get ).
    cut->lo_demo_output = if_demo_output_mock.

    data(output) = cut->if_oo_adt_classrun_out~get( data = string_to_get ).

    cl_abap_unit_assert=>assert_equals( act = output exp = string_to_return ).
    cl_abap_testdouble=>verify_expectations( if_demo_output_mock ).
  endmethod.

